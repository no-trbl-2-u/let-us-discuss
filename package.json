{
  "name": "boardroom",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:run": "vitest run",
    "test": "vitest",
    "data:validate": "node scripts/validate-data.mjs",
    "e2e": "playwright test",
    "verify": "pnpm typecheck && pnpm test:run && pnpm data:validate && pnpm build && pnpm e2e",
    "deploy:check": "node scripts/deploy-check.mjs",
    "lint": "biome check .",
    "format": "biome format --write ."
  }
}
